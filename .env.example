# Copy to .env.local (never commit) and fill in real values.

# Public application origin used by server-side auth requests and callbacks.
# Required in production; development defaults to http://localhost:3000.
APP_BASE_URL=http://localhost:3000

# Required for runtime (pooled connection, use -pooler endpoint)
DATABASE_URL=

# Required for migrations (direct/unpooled connection, NO -pooler)
DIRECT_URL=
# (drizzle.config.ts also reads DATABASE_URL_UNPOOLED as a fallback)

# Neon Auth (managed Better Auth). Base URL is branch-scoped.
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=

# Single-owner allowlist. In production, set these in Vercel env.
# For local dev, you can reuse TEST_OWNER_USER_ID / TEST_OWNER_EMAIL
# from .env.local (set by the HC-A checkpoint).
OWNER_USER_ID=
OWNER_EMAIL=
